# Project Settings
PROJECT_NAME="EduTrack"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database
# Local host development expects PostgreSQL from docker-compose on port 5433.
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5433"
POSTGRES_USER="u_edutrack"
POSTGRES_PASSWORD=p_edutrack_secure
POSTGRES_DB="db_edutrack"

# Security — Run 'openssl rand -hex 32' to generate a real secret key
SECRET_KEY=change-me-run-openssl-rand-hex-32
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
DB_ECHO=false

# AI Insight Queue
AI_INSIGHT_QUEUE_WORKERS=2
AI_INSIGHT_QUEUE_MAX_SIZE=1000

# OTP Security
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_REQUEST_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_10_MIN=5
OTP_MAX_VERIFY_ATTEMPTS_PER_10_MIN=20
ENABLE_MOCK_SMS_OUTPUT=false

# External Services (optional)
OPENAI_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
REDIS_URL="redis://localhost:6380/0"
CELERY_BROKER_URL=""
CELERY_RESULT_BACKEND_URL=""

# Ollama AI Model Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_FALLBACK_MODELS="phi3:mini,llama3.1"

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=""
